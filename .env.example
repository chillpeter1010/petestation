# Backend settings
APP_NAME="Baseball Analysis API"

# Comma-separated origins are accepted by pydantic-settings for list fields in
# local .env usage. Keep production CORS limited to the deployed frontend domain.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]

# Local data root. The backend default also checks ./data first.
DATA_DIR="./data"

# Optional: path to the legacy Streamlit project when running migration/export jobs.
# LEGACY_PROJECT_DIR="C:/Users/your-name/path/to/legacy/project"

# Frontend public runtime setting. Put this in frontend/.env if running the
# frontend with a non-default API URL.
NUXT_PUBLIC_API_BASE="http://127.0.0.1:8000/api"
